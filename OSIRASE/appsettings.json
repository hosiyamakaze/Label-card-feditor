{
  "Osirase": {
    "WatchDirectory": "G:\\CMD\\OSIRASE\\osirase\\in",
    "SentDirectory": "G:\\CMD\\OSIRASE\\osirase\\sent",
    "ErrorDirectory": "G:\\CMD\\OSIRASE\\osirase\\error",
    "RetentionDays": 30,
    "PollIntervalSeconds": 10,
    "FilePattern": "*.txt",
    "Mail": {
      "To": "your@your.com",
      "Cc": "your@your.com",
      "Subject": "お知らせ"
    },
    "Smtp": {
      "Host": "smtp.your.com",
      "Port": 587,
      "UseStartTls": false,
      "User": "your@your.com",
      "Password": "yourpasswd",
      "From": "your@your.com",
      "FromName": "お知らせ(レシピの連絡他)"
    }
  },
  "Logging": {
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
