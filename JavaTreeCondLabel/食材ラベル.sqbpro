alue="98"/><column index="4" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Create LabelIdx">DROP TABLE LabelIdx;

CREATE TABLE LabelIdx (
	Title	TEXT,
	ID	INTEGER,
	Label	TEXT,
	FULL_PATH	TEXT
);

drop index LabelIdx_idx00;

drop index LabelIdx_idx01;

create unique index LabelIdx_idx00 on LabelIdx (
	Title,
	ID
);

create  index LabelIdx_idx01 on LabelIdx (
	ID
);

</sql><sql name="Load LabelIdx*">delete from LabelIdx

INSERT INTO LabelIdx(Title, ID, Label, FULL_PATH )
SELECT
    Title, ID, Label, FULL_PATH 
FROM LabelIdxSTR;
</sql><sql name="Create LabelId">DROP TABLE LabelId;

CREATE TABLE LabelId (
	Id	INTEGER,
	Label	TEXT,
	Expr	TEXT
);


drop index LabelId_idx00;

drop index LabelId_idx01;



create unique index LabelId_idx00 on LabelId (
	Id
);

create  index LabelId_idx01 on LabelId (
	Label
);


</sql><sql name="INSERT LabelId">
